# Application Configuration
PROJECT_NAME="ClauseGuard AI"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1

# Security & JWT Auth
SECRET_KEY=dev_super_secret_clauseguard_jwt_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers (Provide at least one)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
DEFAULT_LLM_MODEL=gemini-1.5-flash

# Vector Store (Qdrant)
# QDRANT_MODE can be "local" (uses embedded on-disk storage) or "server" (connects to host/port)
QDRANT_MODE=local
QDRANT_PATH=./qdrant_storage
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Caching & Queue (Redis)
# REDIS_MODE can be "mock" (uses fakeredis in-memory) or "server" (connects to live Redis)
REDIS_MODE=mock
REDIS_URL=redis://localhost:6379/0

# Ingestion & Uploads
MAX_UPLOAD_SIZE_MB=25
UPLOAD_STORAGE_DIR=./data/raw_uploads
